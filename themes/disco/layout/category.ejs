<section class="wrap">
  <h1 class="sec-title big"><span><%= page.title %></span><em>SELECTION</em></h1>
  <div class="post-list">
    <% page.posts.each(function(post){ %><%- partial('_partial/postcard', {post: post}) %><% }) %>
  </div>
  <%- paginator({ prev: '‹ 上一页', next: '下一页 ›', mid_size: 1, escape: false }) %>
</section>
