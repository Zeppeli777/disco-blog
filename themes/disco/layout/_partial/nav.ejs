<header class="topbar">
  <div class="wrap topbar-in">
    <a class="brand" href="<%- url_for('/') %>">
      <i class="brand-gem" aria-hidden="true"></i>
      <strong><%= config.title %></strong>
      <span class="brand-sep" aria-hidden="true">/</span>
      <em>REVACHOL · CITIZEN'S LOG</em>
    </a>
    <nav class="menu" aria-label="主导航">
      <% theme.menu.forEach(function(item, i){ %>
      <% if (i) { %><span class="menu-slash" aria-hidden="true">/</span><% } %>
      <a class="menu-item" href="<%- url_for(item.url) %>"><span><%= item.label %></span></a>
      <% }) %>
    </nav>
  </div>
</header>
