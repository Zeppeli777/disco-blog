<%
const g = theme.giscus;
if (g && g.enable && g.repo && g.repo_id && g.category_id) {
  const themeUrl = config.url.replace(/\/$/, '') + url_for('css/giscus.css');
%>
<section class="comments">
  <div class="wrap narrow">
    <h2 class="sec-title"><span>证人陈述</span><em>WITNESS STATEMENTS</em></h2>
    <div class="giscus-box">
      <script src="https://giscus.app/client.js"
        data-repo="<%= g.repo %>"
        data-repo-id="<%= g.repo_id %>"
        data-category="<%= g.category %>"
        data-category-id="<%= g.category_id %>"
        data-mapping="<%= g.mapping || 'pathname' %>"
        data-strict="0"
        data-reactions-enabled="<%= g.reactions_enabled == null ? 1 : g.reactions_enabled %>"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="<%= themeUrl %>"
        data-lang="<%= g.lang || 'zh-CN' %>"
        data-loading="lazy"
        crossorigin="anonymous"
        async>
      </script>
    </div>
  </div>
</section>
<% } %>
