<section class="wrap thoughts">
  <h1 class="sec-title big"><span>思维阁</span><em>THOUGHT CABINET</em></h1>
  <p class="th-lead">有些想法在颅内结晶。给文章加上 <code>thought</code> 标签，它就会占据一个槽位，缓慢内化为你的一部分。</p>
  <%
  const tq = site.tags.findOne({slug: 'thought'});
  if (tq && tq.posts && tq.posts.length) { %>
  <div class="tc-list">
    <% tq.posts.sort('date', -1).forEach(function(post){ %>
    <div class="tc-node reveal">
      <div class="tc-orb" aria-hidden="true">
        <svg viewBox="0 0 100 100">
          <circle class="ring-bg" cx="50" cy="50" r="46"/>
          <circle class="ring" cx="50" cy="50" r="46"/>
        </svg>
        <span class="tc-orb-core">⟡</span>
      </div>
      <div class="tc-info">
        <span class="tc-badge">已内化 · INTEGRATED</span>
        <h2><a href="<%- url_for(post.path) %>"><%= post.title %></a></h2>
        <p class="tc-ex"><%= (strip_html(post.excerpt) || strip_html(post.content) || '').trim().replace(/\s+/g, ' ').slice(0, 140) %>…</p>
        <span class="tc-date">结晶于 <%= date(post.date, config.date_format) %> · 研究完成度 100%</span>
      </div>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <div class="tc-empty reveal">
    <div class="tc-orb empty" aria-hidden="true"><span class="tc-orb-core">?</span></div>
    <div class="tc-info">
      <span class="tc-badge">空槽位 · VACANT</span>
      <p class="tc-ex">第一颗想法还未结晶。给任意文章加上 <code>thought</code> 标签，它就会出现在这个槽位里。</p>
    </div>
  </div>
  <% } %>
</section>
